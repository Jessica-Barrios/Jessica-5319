{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client/src",
      "framework": "vite"
    },
    "server": {
      "root": "server/src",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.)",
      "destination": {
        "service": "client"
      }
    }
  ]
}